# SECUREASSESS - Environment Configuration
# SIH 2026 Problem Statement ID: 26163 (NTRO | "Security Assessment of the World Monitor application")

# ------------------------------------------------------------------------------
# 1. HARD SAFETY CONSTRAINTS & TARGET ALLOWLIST
# ------------------------------------------------------------------------------
# Comma-separated list of permitted targets. Checked BEFORE any network packet leaves.
# Accepts localhost, 127.0.0.1, ::1, RFC1918 private ranges, or explicit domains/URLs.
# In SAST mode: only public https://github.com/ repositories are accepted.
ALLOWED_TARGETS=localhost,127.0.0.1,::1,http://localhost:3000,http://127.0.0.1:3000,https://github.com/koala73/worldmonitor

# ------------------------------------------------------------------------------
# 2. RUNTIME & SCAN BUDGET
# ------------------------------------------------------------------------------
# When true, switches real Docker/Kali tool execution to realistic recorded artifacts
# (ZAP, Nikto, Semgrep, Gitleaks JSONs) to guarantee deterministic zero-dependency execution.
DEMO_MODE=true

# Hard cap on scan duration in seconds. Single scan concurrency enforced (409 on overlap).
SCAN_TIMEOUT_S=600

# ------------------------------------------------------------------------------
# 3. LOCAL LLM CONFIGURATION (Ollama)
# ------------------------------------------------------------------------------
# Default local LLM endpoint (enforces format: "json").
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b


# ------------------------------------------------------------------------------
# 4. CLOUD LLM CONFIGURATION (OpenAI-Compatible / NVIDIA NIM Nemotron)
# ------------------------------------------------------------------------------
# Set USE_CLOUD_LLM=true to route deduction to NVIDIA NIM / OpenAI compatible endpoint.
USE_CLOUD_LLM=false
CLOUD_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
CLOUD_LLM_API_KEY=your_nvidia_nim_or_openai_api_key_here

# ------------------------------------------------------------------------------
# 5. STORAGE & AUDIT LOGS
# ------------------------------------------------------------------------------
DB_PATH=./backend/data/secureassess.db
AUDIT_LOG_DIR=./backend/data/audit_logs
