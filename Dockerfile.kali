# ==============================================================================
# SECUREASSESS - Specialized Kali Linux Security Toolchain Container
# SIH 2026 Problem Statement ID: 26163 (NTRO)
# Research Gap #13/#19 (Alazmi): Multi-tool scanner fusion coverage
# ==============================================================================

FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive

# Install core scanning utilities, DAST tools, git, and python runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    nikto \
    zaproxy \
    git \
    python3 \
    python3-pip \
    curl \
    wget \
    ca-certificates \
    jq \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Semgrep (SAST engine)
RUN python3 -m pip install --no-cache-dir --break-system-packages semgrep || true

# Install Gitleaks (Secrets detection)
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then GITLEAKS_ARCH="x64"; elif [ "$ARCH" = "aarch64" ]; then GITLEAKS_ARCH="arm64"; else GITLEAKS_ARCH="x64"; fi && \
    curl -sSL "https://github.com/gitleaks/gitleaks/releases/download/v8.18.2/gitleaks_8.18.2_linux_${GITLEAKS_ARCH}.tar.gz" -o /tmp/gitleaks.tar.gz && \
    tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks && \
    chmod +x /usr/local/bin/gitleaks && \
    rm -f /tmp/gitleaks.tar.gz || true

# Ephemeral workspace and artifact mounts
RUN mkdir -p /tmp/workspace /tmp/artifacts && chmod 777 /tmp/workspace /tmp/artifacts

WORKDIR /tmp/workspace

# Keep container running in the background for orchestrator docker-exec commands
CMD ["tail", "-f", "/dev/null"]
